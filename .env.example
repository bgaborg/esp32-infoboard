# Copy to .env and fill in. .env is gitignored.

# WiFi (ESP32-S3 supports 2.4 GHz only)
WIFI_SSID=
WIFI_PASS=

# BKK FUTAR API key, free at https://opendata.bkk.hu
BKK_API_KEY=

# Header text
STOP_NAME=

# Two stop IDs, one per direction (find with the search endpoint, see README)
STOP_A_ID=
STOP_A_TITLE=
STOP_B_ID=
STOP_B_TITLE=

# Routes to show: ROUTE_ID:Label, comma-separated
ROUTES=
